# DB
POSTGRES_PASSWORD=changeme
POSTGRES_USER=changeme
POSTGRES_DB=changeme

# redis
REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# minio
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=avatars

# jwt — génère une vraie valeur : openssl rand -hex 64
# ⚠️ min 16 caractères : le backend REFUSE de démarrer sinon (validation au boot). Le `changeme`
# ci-dessous (8 car.) est volontairement invalide → il FAUT le remplacer par un vrai secret.
JWT_SECRET=changeme

# Google OAuth
# ⚠️ L'URI de redirection DOIT être enregistrée à l'identique dans la Google Cloud Console.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=https://localhost:5173/api/auth/oauth/google/callback

# Origine applicative UNIQUE côté navigateur (I4). Sert aussi à CORS côté backend.
FRONTEND_URL=https://localhost:5173

# Cibles proxy INTERNES lues par le frontend (vite.config.ts). Non préfixées VITE_ : elles ne
# doivent pas fuiter dans le bundle. Valeurs par défaut = ces mêmes hôtes Docker, à laisser
# telles quelles en local.
API_PROXY_TARGET=https://backend:3000
MINIO_PROXY_TARGET=http://minio:9000
