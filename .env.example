# DB
POSTGRES_PASSWORD=changeme
POSTGRES_USER=changeme
POSTGRES_DB=changeme

# redis
REDIS_HOSTNAME=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# minio
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=avatars

# jwt — 16 caracteres minimum, sinon le backend refuse de demarrer.
# Genere une vraie valeur : openssl rand -hex 64
JWT_SECRET=changeme

# Google OAuth — l'URI de redirection doit etre la meme dans la Google Cloud Console.
GOOGLE_CLIENT_ID=changeme
GOOGLE_CLIENT_SECRET=changeme
GOOGLE_REDIRECT_URI=https://localhost:5173/api/auth/oauth/google/callback

# Seule origine du navigateur, sert aussi au CORS cote backend.
FRONTEND_URL=https://localhost:5173

# Cibles du proxy Vite. Pas de prefixe VITE_ : elles ne doivent pas partir dans le bundle.
API_PROXY_TARGET=https://backend:3000
MINIO_PROXY_TARGET=http://minio:9000

RATE_LIMIT_FACTOR=1
